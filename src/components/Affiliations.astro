---
// School (grad cap) and company (briefcase) lines for a board member card.
interface Props {
  school?: string;
  company?: string;
}
const { school, company } = Astro.props;
---

{(school || company) && (
<div class="mt-3 rounded-xl bg-[#f7f1fb] px-2.5 py-2.5 space-y-1.5">
{school && (
  <p class="flex gap-1.5 text-left text-xs text-[#5e526b]">
    <svg class="w-3.5 h-3.5 shrink-0 mt-px text-[#8a67ad]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="School">
      <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
      <path d="M22 10v6" />
      <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
    </svg>
    <span>{school}</span>
  </p>
)}
{company && (
  <p class="flex gap-1.5 text-left text-xs text-[#5e526b]">
    <svg class="w-3.5 h-3.5 shrink-0 mt-px text-[#8a67ad]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Company">
      <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
      <rect width="20" height="14" x="2" y="6" rx="2" />
    </svg>
    <span>{company}</span>
  </p>
)}
</div>
)}
